services:
  db:
    image: postgres:16-alpine
    container_name: matrix_db
    restart: unless-stopped
    environment:
      POSTGRES_USER: ${DB_USER}
      POSTGRES_PASSWORD: ${DB_PASSWORD}
      POSTGRES_DB: ${DB_NAME}
    ports:
      - "127.0.0.1:5432:5432" # Postgres — localhost only, never expose publicly
    volumes:
      - postgres_data:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U ${DB_USER} -d ${DB_NAME}"]
      interval: 5s
      timeout: 5s
      retries: 10
    networks:
      - app_network

  minio:
    image: minio/minio
    container_name: matrix_minio
    restart: unless-stopped
    ports:
      - "127.0.0.1:9010:9000" # S3 API — localhost only, never expose publicly
      - "127.0.0.1:9011:9001" # MinIO Console → http://localhost:9001
    environment:
      MINIO_ROOT_USER: ${STORAGE_USER}
      MINIO_ROOT_PASSWORD: ${STORAGE_PASSWORD}
    command: server /data --console-address ":9001"
    volumes:
      - minio_data:/data
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:9000/minio/health/live"]
      interval: 5s
      timeout: 5s
      retries: 10
    networks:
      - app_network

  app:
    build: .
    container_name: matrix_app
    restart: unless-stopped
    env_file: .env
    environment:
      # Override localhost URLs with Docker-internal hostnames
      DATABASE_URL: postgresql://${DB_USER}:${DB_PASSWORD}@db:5432/${DB_NAME}
      S3_ENDPOINT: http://minio:9000
    ports:
      - "3000:3000"
    depends_on:
      db:
        condition: service_healthy
      minio:
        condition: service_healthy
    volumes:
      - backups_data:/data/backups
    networks:
      - app_network
    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.frontend.rule=Host(`empregook.com.br`) || Host(`www.empregook.com.br`)"
      - "traefik.http.routers.frontend.tls=true"
      - "traefik.http.routers.frontend.tls.certresolver=lets-encrypt"
      - "traefik.http.services.frontend.loadbalancer.server.port=3000"
      - "traefik.docker.network=app_network"
      - "traefik.http.routers.frontend.middlewares=redirect-www-to-main@file"

  # Optional DB browser — run with: docker compose --profile tools up
  adminer:
    image: adminer
    container_name: matrix_adminer
    restart: unless-stopped
    profiles: [tools]
    ports:
      - "127.0.0.1:8080:8080" # Adminer → http://localhost:8080
    depends_on:
      db:
        condition: service_healthy
    networks:
      - app_network

volumes:
  postgres_data:
  minio_data:
  backups_data:

networks:
  app_network:
    external: true
